<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aftr_gui</name>
  <version>0.2.0</version>
  <description>Operator GUI and integrated fall-safety launch for Autonomous Following and Towing Robot.</description>
  <maintainer email="inpyoi1304@gmail.com">pyo</maintainer>
  <license>Apache License 2.0</license>
  <!-- [User Code Begin] -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>aftr_audio</exec_depend>
  <exec_depend>aftr_fall_detection</exec_depend>
  <exec_depend>aftr_mode_manager</exec_depend>
  <exec_depend>aftr_status_led</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <!-- [User Code End] -->




  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
