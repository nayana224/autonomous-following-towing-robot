  <property name="styleSheet">
   <string notr="true">QWidget#page_safety_stop { background:#FFFFFF; }
QFrame#safety_image_card { background:#111827; border:2px solid #374151; border-radius:18px; }
QFrame#safety_info_card { background:#FFF7ED; border:3px solid #DC2626; border-radius:18px; }
QLabel#label_safety_badge { background:#FEE2E2; color:#991B1B; border:1px solid #F87171; border-radius:10px; padding:10px 16px; font-size:16pt; font-weight:900; }
QLabel#label_safety_title { color:#7F1D1D; font-size:30pt; font-weight:900; }
QLabel#label_safety_message { color:#7F1D1D; font-size:20pt; font-weight:700; }
QLabel#label_safety_detail { background:#FFFFFF; color:#111827; border:1px solid #FED7AA; border-radius:12px; padding:18px; font-size:16pt; font-weight:700; }
QLabel#label_safety_image { color:#E5E7EB; font-size:18pt; font-weight:700; padding:20px; }
QPushButton#btn_clear_safety_stop { min-height:96px; background:#B91C1C; color:#FFFFFF; border:3px solid #7F1D1D; border-radius:16px; padding:16px 22px; font-size:22pt; font-weight:900; }
QPushButton#btn_clear_safety_stop:pressed { background:#7F1D1D; border-color:#450A0A; padding-top:20px; padding-bottom:12px; }
QPushButton#btn_clear_safety_stop:disabled { background:#9CA3AF; color:#F3F4F6; border-color:#6B7280; }</string>
