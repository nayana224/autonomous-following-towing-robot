  <property name="styleSheet">
   <string notr="true">
        QMainWindow, QWidget#centralwidget {
          background-color: #F4F7FB;
        }
        QLabel {
          color: #111827;
          font-weight: 700;
          font-size: 18pt;
          letter-spacing: 0px;
        }
        QLabel#label_linear_vel,
        QLabel#label_angular_vel,
        QLabel#label_robot_status {
          background-color: #FFFFFF;
          border: 1px solid #D8E0EA;
          border-radius: 8px;
          padding: 18px 22px;
          color: #111827;
        }
        QTabWidget::pane {
          background-color: #FFFFFF;
          border: 1px solid #D8E0EA;
          border-radius: 8px;
          top: -1px;
        }
        QTabBar::tab {
          background-color: #EAF0F7;
          color: #334155;
          padding: 8px 18px;
          border-top-left-radius: 6px;
          border-top-right-radius: 6px;
          font-weight: 700;
        }
        QTabBar::tab:selected {
          background-color: #FFFFFF;
          color: #1D4ED8;
          border: 1px solid #D8E0EA;
          border-bottom-color: #FFFFFF;
        }
        QStackedWidget {
          background-color: #FFFFFF;
          border-radius: 8px;
        }
        QMenuBar, QStatusBar {
          background-color: #F4F7FB;
          color: #111827;
        }
        QPushButton {
          border: 1px solid #C9D4E2;
          border-radius: 8px;
          padding: 18px;
          font-weight: 800;
          color: #FFFFFF;
        }
        QPushButton:pressed {
          padding-top: 21px;
          padding-bottom: 15px;
        }
        QPushButton:disabled {
          background-color: #E5EAF1;
          color: #94A3B8;
          border-color: #D8E0EA;
        }
      </string>
  </property>
