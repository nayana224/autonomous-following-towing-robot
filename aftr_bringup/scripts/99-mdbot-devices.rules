# 1. Motor Driver: FTDI FT232 (ID 0403:6001, Serial: BG016MF2)
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="BG016MF2", ENV{ID_MM_DEVICE_IGNORE}="1", MODE:="0666", SYMLINK+="ttyMotor"

# 2. RPLIDAR S2: CP210x (ID 10c4:ea60, Serial: 6e476068267eef119b29181cedd322a4)
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="6e476068267eef119b29181cedd322a4", ENV{ID_MM_DEVICE_IGNORE}="1", MODE:="0666", SYMLINK+="ttyLidar"